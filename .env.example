# Base URL of the backend API server (without trailing slash).
# The app appends "/api" to this for API requests.
REACT_APP_API_URL=https://your-backend.example.com

# URL of the Socket.IO server for real-time chat.
# Optional - falls back to REACT_APP_API_URL when not set.
REACT_APP_SOCKET_URL=https://your-backend.example.com

# URL of the seller/admin dashboard frontend.
REACT_APP_DASHBOARD_URL=https://your-dashboard.example.com

# Stripe publishable key (safe to expose on the client).
# Use your test key for development, live key for production.
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Social login (safe to expose on the client).
# Google OAuth 2.0 Web Client ID (must match backend GOOGLE_CLIENT_ID).
REACT_APP_GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
# Facebook App ID (from Facebook for Developers).
REACT_APP_FACEBOOK_APP_ID=your_facebook_app_id
